<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_timeout="4000"
        app:use_controller="false"
        app:resize_mode="fit"
        app:show_buffering="never" />

    <!-- Custom Controls Overlay -->
    <FrameLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/top_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:background="@drawable/bg_player_top_gradient">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_player_button"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tv_video_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Center Play/Pause Controls -->
        <LinearLayout
            android:id="@+id/center_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Seek Back -->
            <FrameLayout
                android:id="@+id/btn_seek_back"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_button">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_seek_back"
                    android:contentDescription="Seek back" />
            </FrameLayout>

            <!-- Play/Pause -->
            <FrameLayout
                android:id="@+id/btn_play_pause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="28dp"
                android:background="@drawable/bg_play_button">

                <ImageView
                    android:id="@+id/iv_play_pause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:contentDescription="Play/Pause" />
            </FrameLayout>

            <!-- Seek Forward -->
            <FrameLayout
                android:id="@+id/btn_seek_forward"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_button">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_seek_forward"
                    android:contentDescription="Seek forward" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom Controls -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_player_controls"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Seek Bar -->
            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:progressDrawable="@drawable/bg_seek_progress"
                android:thumbTint="@color/white"
                android:max="1000" />

            <!-- Time and controls row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:text="0:00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#66FFFFFF"
                    android:textSize="13sp"
                    android:text=" / "
                    android:layout_marginHorizontal="2dp" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp"
                    android:text="0:00" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Playback Speed -->
                <TextView
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="1x"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_player_button" />

                <!-- Fullscreen -->
                <ImageView
                    android:id="@+id/btn_fullscreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_fullscreen"
                    android:background="@drawable/bg_player_button"
                    android:contentDescription="Fullscreen" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buffering Indicator -->
        <ProgressBar
            android:id="@+id/buffering_indicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/white" />
    </FrameLayout>
</FrameLayout>
